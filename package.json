{
  "name": "vitepress-plugin-sfc",
  "version": "2.0.0-beta.1",
  "description": "VitePress plugin that renders inline Vue SFC with tabs showing preview and source code",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": "./src/client/index.ts"
  },
  "files": [
    "dist",
    "src/client"
  ],
  "types": "./dist/index.d.mts",
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown --minify",
    "bump": "bumpp --sign",
    "pub": "npm run build && npm publish --registry=https://registry.npmjs.org/",
    "dev:docs": "pnpm -C playground dev"
  },
  "keywords": [
    "vitepress",
    "vitepress-plugin",
    "vitepress plugin",
    "plugin",
    "vue",
    "component",
    "tabs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "hotdogc1017@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heroui-vue/vitepress-plugin-sfc"
  },
  "devDependencies": {
    "@babel/parser": "8.0.0-rc.5",
    "@babel/traverse": "8.0.0-rc.5",
    "@rolldown/pluginutils": "^1.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^2.0.10",
    "@types/node": "^22.17.0",
    "bumpp": "^10.1.0",
    "markdown-it-container": "^4.0.0",
    "tsdown": "0.21.10",
    "typescript": "^5.8.3",
    "unplugin-vue": "^6.2.0",
    "vitepress": "next",
    "vue": "^3.5.0"
  }
}
