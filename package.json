{
  "name": "vitepress-plugin-sfc",
  "version": "2.0.0-beta.2",
  "description": "Allows you to write Vue SFC within Markdown files and render them in VitePress.",
  "keywords": [
    "component",
    "plugin",
    "tabs",
    "vitepress",
    "vitepress plugin",
    "vitepress-plugin",
    "vue"
  ],
  "bugs": {
    "url": "https://github.com/heroui-vue/vitepress-plugin-sfc/issues"
  },
  "license": "MIT",
  "author": "hotdogc1017@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/heroui-vue/vitepress-plugin-sfc"
  },
  "files": [
    "dist",
    "src/client"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": "./src/client/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown --minify",
    "bump": "bumpp --sign",
    "pub": "npm run build && npm publish --registry=https://registry.npmjs.org/",
    "dev:docs": "pnpm -C playground dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "vitest run -r __tests__"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^2.0.10",
    "@types/node": "^22.17.0",
    "bumpp": "^10.1.0",
    "markdown-it-container": "^4.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsdown": "0.21.10",
    "typescript": "^5.8.3",
    "unplugin-vue": "^6.2.0",
    "vitepress": "next",
    "vitest": "^5.0.4",
    "vue": "^3.5.0"
  }
}
